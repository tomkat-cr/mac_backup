# Path to backup on the Mac
SOURCE_DIR="/Users/yourname/Documents/"
# Linux server user
REMOTE_USER="pi_user"
# Linux server IP or hostname
REMOTE_HOST="192.168.1.XX"
# Target directory on the Linux server
TARGET_DIR="/home/pi_user/backups/macbook/"
# Log file on the Mac
LOG_FILE="/Users/yourname/logs/backup.log"
# SSH Key file name
SSH_KEY_FILE="id_ed25519"
